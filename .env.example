# Payment Black Box Environment Variables

# Choose Database Type
# Set to 'postgres' to use PostgreSQL (requires Docker). 
# Set to 'sqlite' for a lightweight, file-based local database (no Docker required).
DB_TYPE=sqlite

# PostgreSQL Settings (Used if DB_TYPE=postgres)
POSTGRES_USER=pbx_user
POSTGRES_PASSWORD=pbx_password
POSTGRES_DB=payment_black_box
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Settings (Used if DB_TYPE=postgres)
REDIS_URL=redis://localhost:6379/0

# API Settings
PORT=8000
HOST=0.0.0.0
